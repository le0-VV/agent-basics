#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_setup_script() {
  local candidate
  for candidate in \
    "${AGENT_BASICS_SETUP_SCRIPT:-}" \
    "$SCRIPT_DIR/setup-macos.sh"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done
  echo "Error: setup-macos.sh was not found next to agent-basics." >&2
  return 1
}

find_memory_cli() {
  local candidate
  for candidate in \
    "${AGENT_BASICS_MEMORY_CLI:-}" \
    "$SCRIPT_DIR/agent-memory.py" \
    "$SCRIPT_DIR/compat/memory-rag/agent-memory.py" \
    "$SCRIPT_DIR/.agents/memory/rag/agent-memory.py" \
    "$(pwd)/.agents/memory/rag/agent-memory.py"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done
  echo "Error: agent-basics memory CLI was not found." >&2
  echo "Run \`agent-basics setup\` for this repository or reinstall agent-basics." >&2
  return 1
}

find_memory_mcp() {
  local candidate
  for candidate in \
    "${AGENT_BASICS_MEMORY_MCP:-}" \
    "$SCRIPT_DIR/memory-mcp.py" \
    "$SCRIPT_DIR/compat/memory-rag/memory-mcp.py" \
    "$SCRIPT_DIR/.agents/memory/rag/memory-mcp.py" \
    "$(pwd)/.agents/memory/rag/memory-mcp.py"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done
  echo "Error: agent-basics memory MCP server was not found." >&2
  echo "Run \`agent-basics setup\` for this repository or reinstall agent-basics." >&2
  return 1
}

find_ov_helper() {
  local candidate
  for candidate in \
    "${AGENT_BASICS_OV_HELPER:-}" \
    "$SCRIPT_DIR/agent-basics-ov.py" \
    "$SCRIPT_DIR/scripts/agent_basics_ov.py"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done
  echo "Error: agent-basics OpenViking helper was not found." >&2
  echo "Reinstall agent-basics or run from the full agent-basics checkout." >&2
  return 1
}

usage() {
  cat <<'EOT'
Usage:
  agent-basics [--repo DIR] [--language en|zh-CN|auto] setup [options] [DIR]
  agent-basics [--repo DIR] [--language en|zh-CN|auto] upgrade [options] [DIR]
  agent-basics [--repo DIR] memory <validate|rebuild|search|record|doctor|install-hooks> [...]
  agent-basics [--repo DIR] mcp
  agent-basics [--repo DIR] ov <doctor|status|search|read|record|add-resource|add-skill|ingest-changed|install-hooks|install-system|bootstrap-system|write-default-config|service|server|import-repo-memory> [...]
  agent-basics [--repo DIR] lmstudio <status|hardware|bootstrap|service|plan|configure|load|unload|route-test> [...]
  agent-basics [--repo DIR] migrate memory-to-openviking [--write]
  agent-basics [--repo DIR] verify
  agent-basics [--repo DIR] commit <type(scope): description>
  agent-basics [--repo DIR] doctor [--online]
  agent-basics [--repo DIR] validate|rebuild|search|record|install-hooks [...]

Setup and upgrade both run the repository setup flow. Re-running setup on an
existing repository is the supported upgrade path; markdown conflicts are
handled by the existing keep/replace/append/manual/web-merge/save prompts.

Setup options:
  --embedding-mode api|huggingface
  --embedding-base-url URL
  --embedding-model NAME
  --embedding-api-key-env NAME
  --embedding-hf-model OWNER/MODEL_OR_URL
  --embedding-timeout SECONDS
  --embedding-batch-size N
  --embedding-min-dimensions N
  --project-name NAME
  --language en|zh-CN|auto
      Set the installation-wide agent-basics language used by setup output and
      generated agent instructions.

OpenViking is the target required backend for memory, resources, skills, and
retrieval. `agent-basics ov` uses a user-level OpenViking installation, normally
under ~/.openviking, instead of installing OpenViking into each repository.
Fresh setup creates `.agents/memory/` as the OpenViking source store.
Use `agent-basics ov import-repo-memory --write` to write repo OV-native memory
files into OpenViking memory categories and ingest resources/skills.
Use `agent-basics ov bootstrap-system` to install or repair the user-level
OpenViking package, default config, and macOS LaunchAgent. Use
`agent-basics ov server` for foreground debugging.

LM Studio model management uses REST/OpenAI-compatible HTTP endpoints. Do not
call the interactive `lms` CLI from Codex on macOS; bootstrap may install a
LaunchAgent that runs `lms server start` outside the agent process.

MCP clients should use:
  command: agent-basics
  arguments: mcp
  working directory: optional

The MCP implementation is OpenViking-backed and repo-aware. It infers the
repository from each tool call's `cwd` argument. `cwd` may be the repository
root or any directory inside it. `repo_path` remains as a backward-compatible
alias.
EOT
}

repo_dir=""
language=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -C|--repo|--cwd)
      if [[ $# -lt 2 ]]; then
        echo "Error: $1 requires a directory." >&2
        exit 2
      fi
      repo_dir="$2"
      shift 2
      ;;
    --language|--lang)
      if [[ $# -lt 2 ]]; then
        echo "Error: $1 requires a language." >&2
        exit 2
      fi
      language="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      echo "agent-basics 0.1.0"
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

command_name="${1:-setup}"
if [[ $# -gt 0 ]]; then
  shift
fi

run_setup() {
  local target_dir=""
  local embedding_mode=""
  local embedding_base_url=""
  local embedding_model=""
  local embedding_api_key_env=""
  local embedding_hf_model=""
  local embedding_timeout=""
  local embedding_batch_size=""
  local embedding_min_dimensions=""
  local project_name=""
  local setup_language="$language"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --embedding-mode)
        [[ $# -ge 2 ]] || { echo "Error: --embedding-mode requires a value." >&2; exit 2; }
        embedding_mode="$2"
        shift 2
        ;;
      --embedding-base-url)
        [[ $# -ge 2 ]] || { echo "Error: --embedding-base-url requires a value." >&2; exit 2; }
        embedding_base_url="$2"
        shift 2
        ;;
      --embedding-model)
        [[ $# -ge 2 ]] || { echo "Error: --embedding-model requires a value." >&2; exit 2; }
        embedding_model="$2"
        shift 2
        ;;
      --embedding-api-key-env)
        [[ $# -ge 2 ]] || { echo "Error: --embedding-api-key-env requires a value." >&2; exit 2; }
        embedding_api_key_env="$2"
        shift 2
        ;;
      --embedding-hf-model)
        [[ $# -ge 2 ]] || { echo "Error: --embedding-hf-model requires a value." >&2; exit 2; }
        embedding_hf_model="$2"
        shift 2
        ;;
      --embedding-timeout)
        [[ $# -ge 2 ]] || { echo "Error: --embedding-timeout requires a value." >&2; exit 2; }
        embedding_timeout="$2"
        shift 2
        ;;
      --embedding-batch-size)
        [[ $# -ge 2 ]] || { echo "Error: --embedding-batch-size requires a value." >&2; exit 2; }
        embedding_batch_size="$2"
        shift 2
        ;;
      --embedding-min-dimensions)
        [[ $# -ge 2 ]] || { echo "Error: --embedding-min-dimensions requires a value." >&2; exit 2; }
        embedding_min_dimensions="$2"
        shift 2
        ;;
      --project-name)
        [[ $# -ge 2 ]] || { echo "Error: --project-name requires a value." >&2; exit 2; }
        project_name="$2"
        shift 2
        ;;
      --language|--lang)
        [[ $# -ge 2 ]] || { echo "Error: --language requires a value." >&2; exit 2; }
        setup_language="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      -*)
        echo "Error: unknown setup option: $1" >&2
        exit 2
        ;;
      *)
        if [[ -n "$target_dir" ]]; then
          echo "Error: setup accepts at most one target directory." >&2
          exit 2
        fi
        target_dir="$1"
        shift
        ;;
    esac
  done
  if [[ $# -gt 0 ]]; then
    if [[ -n "$target_dir" || $# -gt 1 ]]; then
      echo "Error: setup accepts at most one target directory." >&2
      exit 2
    fi
    target_dir="$1"
  fi
  if [[ -z "$target_dir" ]]; then
    if [[ -n "$repo_dir" ]]; then
      target_dir="$repo_dir"
    else
      target_dir="$(pwd)"
    fi
  fi
  if [[ -n "$embedding_mode" ]]; then export AGENT_BASICS_EMBEDDING_MODE="$embedding_mode"; fi
  if [[ -n "$embedding_base_url" ]]; then export AGENT_BASICS_EMBEDDING_BASE_URL="$embedding_base_url"; fi
  if [[ -n "$embedding_model" ]]; then export AGENT_BASICS_EMBEDDING_MODEL="$embedding_model"; fi
  if [[ -n "$embedding_api_key_env" ]]; then export AGENT_BASICS_EMBEDDING_API_KEY_ENV="$embedding_api_key_env"; fi
  if [[ "$embedding_mode" == "api" && -z "$embedding_api_key_env" ]]; then export AGENT_BASICS_EMBEDDING_API_KEY_ENV=""; fi
  if [[ -n "$embedding_hf_model" ]]; then export AGENT_BASICS_EMBEDDING_HF_MODEL="$embedding_hf_model"; fi
  if [[ -n "$embedding_timeout" ]]; then export AGENT_BASICS_EMBEDDING_TIMEOUT="$embedding_timeout"; fi
  if [[ -n "$embedding_batch_size" ]]; then export AGENT_BASICS_EMBEDDING_BATCH_SIZE="$embedding_batch_size"; fi
  if [[ -n "$embedding_min_dimensions" ]]; then export AGENT_BASICS_EMBEDDING_MIN_DIMENSIONS="$embedding_min_dimensions"; fi
  if [[ -n "$project_name" ]]; then export AGENT_BASICS_PROJECT_NAME="$project_name"; fi
  if [[ -n "$setup_language" ]]; then
    export AGENT_BASICS_LANGUAGE="$setup_language"
    export AGENT_BASICS_LANGUAGE_EXPLICIT=1
  fi
  exec "$(find_setup_script)" "$target_dir"
}

enter_repo() {
  if [[ -n "$repo_dir" ]]; then
    cd "$repo_dir"
  fi
}

run_verify() {
  enter_repo
  python3 - "$@" <<'PY'
from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path


def command_label(command: list[str]) -> str:
    return " ".join(command)


def indent_block(label: str, text: str) -> None:
    if not text:
        return
    print(f"  {label}:")
    for line in text.rstrip().splitlines():
        print(f"    {line}")


def run_check(name: str, command: list[str]) -> bool:
    print(f"[RUN] {name}")
    print(f"  command: {command_label(command)}")
    completed = subprocess.run(
        command,
        cwd=Path.cwd(),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    status = "PASS" if completed.returncode == 0 else "FAIL"
    print(f"[{status}] {name} (exit {completed.returncode})")
    indent_block("stdout", completed.stdout)
    indent_block("stderr", completed.stderr)
    return completed.returncode == 0


def skip_check(name: str, reason: str) -> None:
    print(f"[SKIP] {name}: {reason}")


def main(argv: list[str]) -> int:
    if argv:
        print("Error: verify does not accept arguments.", file=sys.stderr)
        return 2

    repo = Path.cwd()
    print("agent-basics verify")
    print(f"repo: {repo}")
    print()

    failed = 0

    tests_dir = repo / "tests"
    if tests_dir.is_dir():
        if run_check("unit tests", [sys.executable, "-m", "unittest", "discover", "-s", "tests"]):
            pass
        else:
            failed += 1
    else:
        skip_check("unit tests", "tests directory not found")

    if (repo / "Cargo.toml").is_file() and shutil.which("cargo"):
        if not run_check("cargo test", ["cargo", "test"]):
            failed += 1
    elif (repo / "Cargo.toml").is_file():
        skip_check("cargo test", "cargo not found")
    else:
        skip_check("cargo test", "Cargo.toml not found")

    if (repo / "setup-macos.sh").is_file():
        if not run_check("setup-macos.sh syntax", ["bash", "-n", "setup-macos.sh"]):
            failed += 1
    else:
        skip_check("setup-macos.sh syntax", "setup-macos.sh not found")

    formula = repo / "Formula" / "agent-basics.rb"
    if formula.is_file() and shutil.which("ruby"):
        if not run_check("Homebrew formula syntax", ["ruby", "-c", str(formula.relative_to(repo))]):
            failed += 1
    elif formula.is_file():
        skip_check("Homebrew formula syntax", "ruby not found")
    else:
        skip_check("Homebrew formula syntax", "Formula/agent-basics.rb not found")

    dispatcher = repo / "agent-basics"
    if dispatcher.is_file() and dispatcher.stat().st_mode & 0o111:
        if not run_check("OpenViking offline status", ["./agent-basics", "ov", "status", "--offline"]):
            failed += 1
    elif dispatcher.is_file():
        skip_check("OpenViking offline status", "./agent-basics is not executable")
    else:
        skip_check("OpenViking offline status", "./agent-basics not found")

    print()
    if failed:
        print(f"Verification failed: {failed} check(s) failed.", file=sys.stderr)
        return 1
    print("Verification passed.")
    return 0


raise SystemExit(main(sys.argv[1:]))
PY
}

run_commit() {
  enter_repo
  python3 - "$@" <<'PY'
from __future__ import annotations

import os
import re
import subprocess
import sys


ALLOWED_TYPES = "build|chore|CI|docs|feat|fix|perf|refactor|revert|style|test"
MESSAGE_RE = re.compile(rf"^({ALLOWED_TYPES})\([A-Za-z0-9._/-]+\): \S.+$")


def fail(message: str, *, code: int = 1) -> None:
    print(f"Error: {message}", file=sys.stderr)
    raise SystemExit(code)


def git_output(args: list[str]) -> str:
    completed = subprocess.run(
        ["git", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip()
        fail(detail or f"git {' '.join(args)} failed")
    return completed.stdout.strip()


def parse_message(argv: list[str]) -> str:
    if not argv:
        fail("commit requires a message.", code=2)
    if argv[0] in {"-m", "--message"}:
        if len(argv) != 2:
            fail("commit -m accepts exactly one message.", code=2)
        return argv[1]
    return " ".join(argv)


def main(argv: list[str]) -> int:
    message = parse_message(argv).strip()
    if not MESSAGE_RE.match(message):
        fail(
            "commit message must match `{type}({scope}): {description}` with type one of "
            f"{ALLOWED_TYPES.replace('|', ', ')}.",
            code=2,
        )

    staged = subprocess.run(["git", "diff", "--cached", "--quiet"], check=False)
    if staged.returncode == 0:
        fail("no staged changes to commit.")
    if staged.returncode not in {0, 1}:
        fail("unable to inspect staged changes; are you in a git repository?")

    global_name = git_output(["config", "--global", "user.name"])
    global_email = git_output(["config", "--global", "user.email"])
    if not global_name:
        fail("global git user.name is not configured.")
    if not global_email:
        fail("global git user.email is not configured.")

    author_name = f"Coding agent supervised by {global_name}"
    env = dict(os.environ)
    env.update(
        {
            "GIT_AUTHOR_NAME": author_name,
            "GIT_AUTHOR_EMAIL": global_email,
            "GIT_COMMITTER_NAME": author_name,
            "GIT_COMMITTER_EMAIL": global_email,
        }
    )
    completed = subprocess.run(
        [
            "git",
            "-c",
            f"user.name={author_name}",
            "-c",
            f"user.email={global_email}",
            "commit",
            "-m",
            message,
        ],
        text=True,
        env=env,
        check=False,
    )
    return completed.returncode


raise SystemExit(main(sys.argv[1:]))
PY
}

case "$command_name" in
  setup|init|install|upgrade)
    run_setup "$@"
    ;;
  memory|rag)
    if [[ $# -eq 0 ]]; then
      echo "Error: memory requires a subcommand." >&2
      usage >&2
      exit 2
    fi
    enter_repo
    exec "$(find_memory_cli)" "$@"
    ;;
  mcp|mcp-server|serve-mcp)
    if [[ $# -gt 0 ]]; then
      echo "Error: mcp does not accept arguments." >&2
      exit 2
    fi
    enter_repo
    exec python3 "$(find_ov_helper)" --repo "$(pwd)" mcp
    ;;
  ov|openviking)
    enter_repo
    exec python3 "$(find_ov_helper)" --repo "$(pwd)" ov "$@"
    ;;
  lmstudio)
    enter_repo
    exec python3 "$(find_ov_helper)" --repo "$(pwd)" lmstudio "$@"
    ;;
  migrate)
    enter_repo
    exec python3 "$(find_ov_helper)" --repo "$(pwd)" migrate "$@"
    ;;
  verify)
    run_verify "$@"
    ;;
  commit)
    run_commit "$@"
    ;;
  doctor)
    enter_repo
    exec python3 "$(find_ov_helper)" --repo "$(pwd)" ov doctor "$@"
    ;;
  validate|rebuild|search|record|install-hooks)
    enter_repo
    exec "$(find_memory_cli)" "$command_name" "$@"
    ;;
  help)
    usage
    ;;
  *)
    if [[ $# -eq 0 && ( -d "$command_name" || "$command_name" == "." || "$command_name" == /* || "$command_name" == ~* ) ]]; then
      run_setup "$command_name"
    fi
    echo "Error: unknown command: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
